DATABASE_URL=sqlite:///./eval_platform.db
UPLOAD_DIR=./uploads
CORS_ORIGINS=["http://localhost:5173"]
SEED_ON_STARTUP=true
RUN_EVAL_ON_CREATE=true

DEFAULT_LLM_NAME="Qwen Plus (通义千问)"
LLM_PROVIDER=openai
LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=xxx
LLM_TEMPERATURE=0.01
LLM_MAX_TOKENS=1024

# ===== RSI evaluation-driven self-evolution =====
# Set to false to disable /api/rsi/* (returns 403) and hide the feature.
RSI_ENABLED=true
RSI_MAX_ITERATIONS=3
RSI_MAX_ROWS_PER_ITERATION=50
RSI_MAX_LLM_CALLS=300
RSI_MAX_MINUTES=45
RSI_MAX_PROPOSALS_PER_ITERATION=3
RSI_HOLDOUT_RATIO=0.3
RSI_HOLDOUT_MIN_ROWS=10
RSI_HOLDOUT_MIN_ROWS_AUTO=30
RSI_MIN_OBJECTIVE_GAIN=0.03
RSI_MAX_METRIC_DROP=0.02
RSI_MAX_ERROR_RATE_DELTA=0.02
RSI_MAX_JUDGE_DRIFT=0.15
RSI_AUTO_APPLY_LOW_RISK=false
RSI_PROPOSER_TEMPERATURE=0.2
